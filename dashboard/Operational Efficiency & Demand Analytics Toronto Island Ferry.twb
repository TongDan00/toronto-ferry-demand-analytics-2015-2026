            <column aggregation='Sum' caption='Is Weekend' datatype='integer' name='[Is_Weekend]' role='dimension' type='ordinal' />
            <column caption='Net Queue Change' datatype='integer' name='[Net_Queue_Change]' role='measure' type='quantitative' />
            <column datatype='datetime' name='[Timestamp]' role='dimension' type='ordinal' />
            <column-instance column='[Is_Off_Season]' derivation='None' name='[none:Is_Off_Season:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Is_Weekend]' derivation='None' name='[none:Is_Weekend:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Net_Queue_Change]' derivation='Sum' name='[sum:Net_Queue_Change:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Timestamp]' derivation='Hour-Trunc' name='[thr:Timestamp:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1m5fhxl0f8ylbw1e62t1r1z0p3jl].[none:Is_Off_Season:ok]'>
            <groupfilter function='member' level='[none:Is_Off_Season:ok]' member='0' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
